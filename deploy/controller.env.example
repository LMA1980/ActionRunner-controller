# ActionRunner Controller Environment Configuration
# Installed to /etc/action-runner/controller.env

ACTION_RUNNER_BIND=127.0.0.1:8000
ACTION_RUNNER_WORKSPACE=/var/lib/action-runner/workspace
ACTION_RUNNER_ALLOWED_REPOS=LMA1980/*
ACTION_RUNNER_TIMEOUT_SECS=600

# Path to HMAC Webhook Secret file (or literal token)
GITHUB_WEBHOOK_SECRET=/etc/action-runner/github_webhook_secret

# Cluster Worker Authentication Token (shared with workers via /api/cluster/tunnel)
ACTION_RUNNER_CLUSTER_TOKEN=/etc/action-runner/cluster_token

# Optional: API key required for accessing /api/jobs/{id}/log endpoint
# ACTION_RUNNER_LOG_API_KEY=your-secret-api-key
