# ==============================================================================
# ActionRunner Distributed Controller Configuration Environment
# Path: /etc/action-runner/controller.env (Permissions: 0600 action-runner:action-runner)
# ==============================================================================

# TCP bind address for the controller daemon
ACTION_RUNNER_BIND=0.0.0.0:8000

# Base workspace directory on the controller host
ACTION_RUNNER_WORKSPACE=/var/lib/action-runner/workspace

# Allowed repository glob pattern for GitHub webhook ingestion
ACTION_RUNNER_ALLOWED_REPOS=LMA1980/*

# Path to GitHub Webhook HMAC secret file (or literal secret token)
GITHUB_WEBHOOK_SECRET=/etc/action-runner/github_webhook_secret

# Path to Shared Cluster Worker Authentication Token (or literal token)
ACTION_RUNNER_CLUSTER_TOKEN=/etc/action-runner/cluster_token

# Maximum concurrent jobs executed simultaneously across the cluster (default: 2)
ACTION_RUNNER_MAX_CONCURRENT_JOBS=2

# GitHub Personal Access Token / App token for reporting commit status checks (k3-ci)
# Path to token file (recommended) or literal token
GITHUB_TOKEN=/etc/action-runner/github_token

# Tracing and logging level
RUST_LOG=info,action_runner_controller=debug
