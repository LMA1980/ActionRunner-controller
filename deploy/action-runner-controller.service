[Unit]
Description=ActionRunner Distributed Cluster Controller & WebAPI
Documentation=https://github.com/LMA1980/ActionRunner-controller
After=network.target

[Service]
Type=simple
User=action-runner
Group=action-runner
WorkingDirectory=/var/lib/action-runner
EnvironmentFile=/etc/action-runner/controller.env
ExecStart=/usr/local/bin/action-runner-controller
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

ReadWritePaths=/var/lib/action-runner
InaccessiblePaths=/etc/shadow /root

[Install]
WantedBy=multi-user.target
